PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/pathwise

JWT_ACCESS_SECRET=replace_me_access_secret
JWT_ACCESS_EXPIRES_IN=1h

# Cookie settings (when using credentials: include from frontend)
COOKIE_NAME=pathwise_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# AI engine service
AI_ENGINE_URL=http://localhost:7000

# Optional: admin bootstrap email (for demos)
ADMIN_EMAIL=admin@pathwise.local
ADMIN_PASSWORD=admin12345

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_DELIVERY=log

# SMTP (only if OTP_DELIVERY=smtp)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
